*-------------------------------
* Setup
*-------------------------------
clear all
set more off
set matsize 4000
global seed 4553
graph set window fontface "Times New Roman"
set scheme s1color

*--------------------------------------------------
* Loop over outcomes and predictors, DV1- language
*--------------------------------------------------
* Load stacked SNAD + SNACK data
cd "C:\Users\windy\OneDrive - Indiana University\1_IU_Project\SNAD\4_Cog_Bri\correctiontest"
set scheme s1color

*--------------------------------------------------
* Loop over outcomes and predictors, DV1- language 
*--------------------------------------------------
use "snack_snad_merged_std_0720.dta", clear

sum std_language std_epmem std_moca_raw MCI_rev
set matsize 11000


local predictors `"married parenthood working livealone grphouse anyvolunteer std_church_day std_famfriends_day std_smcount  assisting_adult widowed anybrevement phassles std_friends std_family std_marriage std_frndsupp std_famsupp std_msupport3 std_communityscale std_pkin std_pclose std_padvice std_pprox std_mfreq std_ploan std_pchores std_bridging std_efctsize std_diverse std_density_rev std_density std_netsize std_avg_euc_age std_weakest std_occcomplex_people std_diff_college std_diff_white std_numphonecontact std_pfriend sole std_diff_race std_sdage std_pcollege std_pwhite"'





* Store output in a temporary dataset
tempname results1
postfile `results1' str30 predictor double coef se pval using temp_std_language.dta, replace

* Loop through predictors
foreach x of local predictors {
    display "-------------------------------------------------------------"
    display "Running model: std_language ~ `x'"
    
    capture noisily meglm std_language c.std_ageall female white college std_faq gds_h i.dummysource `x' || surveyid:

    if _rc == 0 {
        matrix b = e(b)
        matrix V = e(V)

        local colnames : colnames b
        local found = 0

        forvalues j = 1/`=colsof(b)' {
            local colname = word("`colnames'", `j')
            display "Checking: `x' in colname[`j'] = `colname'"
            if strpos("`colname'", "`x'") > 0 {
                local row = `j'
                local found = 1
                continue, break
            }
        }

        if `found' {
            scalar coef = b[1, `row']
            scalar se   = sqrt(V[`row', `row'])
            scalar t    = coef / se
            scalar df   = e(df_r)
            scalar p    = 2*(normal(-abs(_b[`x']/_se[`x'])))
			
			
            post `results1' ("`x'") (coef) (se) (p)
            display "Posted: `x'  coef=`=coef'  se=`=se'  p=`=p'"
        }
        else {
            display as error "Predictor `x' NOT FOUND in e(b)"
        }
    }
    else {
        display as error "Model failed for `x' (return code `_rc')"
    }
}

postclose `results1'

* Load results and inspect
clear all
use temp_std_language.dta, clear
*list in 1/10

* Smile plot * 
// Benjamini–Hochberg (BH) False Discovery Rate (FDR)
smileplot, pvalue(pval) estimate(coef) ptlabel(predictor) method(simes) ///
    scatteropts(mlabpos(12) mlabsize(small) msymbol(circle) msize(small) ///
                mcolor(blue)) ///
    refopts(lpattern(shortdash) lcolor(gs10) lwidth(thin)) ///
xtitle("Somers’ D ", size(small)) ///
ytitle("Un/corrected P-values", size(small)) ylabel(,nogrid) ///
graphregion(color(white) lstyle(none)) plotregion(color(white) lstyle(none)) ///
title("Verbal Fluency", size(medium)) /// 
saving (languagepvalue.gph, replace)
*title("Smile Plot of Social Predictors") ///
*subtitle("Adjusted p-values (Benjamini–Hochberg method)") ///
*note("Markers labeled by predictor; dashed line indicates reference p=0.05")
	
graph export "smile_simes_language.png", as(png) replace
graph close

